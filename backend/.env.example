# ==============================================================================
# MediConnect Backend Environment Template (Placeholders Only - Never Commit Secrets)
# ==============================================================================
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password_here
DB_NAME=mediconnect_db
DB_CONNECTION_LIMIT=10

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
