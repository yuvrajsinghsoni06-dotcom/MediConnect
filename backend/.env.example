# MediConnect Backend Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mediconnect_db
DB_CONNECTION_LIMIT=10

# Security & Authentication
JWT_SECRET=mediconnect-super-secret-jwt-key-change-in-production-2026
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
