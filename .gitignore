# ==============================================================================
# MediConnect — Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
!backend/.env.example

# Database Backups & Local Data Dumps
backend/db/backups/
*.sql.gz
*.sql.bak
backend/db/backups/*.sql
!backend/db/seeds/*.sql
!backend/db/migrations/*.sql

# Production Build Artifacts
dist/
dist-ssr/
build/
*.local

# Logs and runtime data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test & Coverage Outputs
coverage/
*.lcov
.nyc_output/

# Editor & OS Specific
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Vite & Vitest Cache
.vite/
